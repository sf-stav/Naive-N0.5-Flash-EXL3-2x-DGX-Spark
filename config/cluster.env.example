# Copy to config/cluster.env and edit. Read by every script in scripts/.
# The repo must be checked out at the same path on both Sparks.

# --- nodes (IPs on the ConnectX / RoCE link between the two Sparks) -------------------------
HEAD_IP=192.168.177.12          # runs the Ray head, the API server and GPU rank 0
WORKER_IP=192.168.177.11        # runs the Ray worker and GPU rank 1
SSH_OPTS="-o StrictHostKeyChecking=accept-new -o ConnectTimeout=10"   # add "-i <key>" if needed

# --- RoCE / NCCL (check with: ibv_devinfo | grep -E 'hca_id|state'; ip -br addr) ------------
NET_IF=enp1s0f1np1              # netdev that carries HEAD_IP / WORKER_IP
NCCL_IB_HCA=rocep1s0f1          # RDMA device on that port (PORT_ACTIVE)
NCCL_IB_GID_INDEX=3             # RoCE v2 GID index

# --- paths (identical on both nodes) --------------------------------------------------------
VENV=$HOME/venvs/naive-n05-exl3
SRC_DIR=$HOME/src/naive-n05-exl3            # clones of vllm-exl3 and exllamav3 (install.sh)
MODEL_DIR=$HOME/models/Naive-N0.5-Flash-EXL3-3.5bpw
DRAFT_DIR=$HOME/models/Naive-N0.5-Flash-FP8-Draft
RUN_DIR=$HOME/.cache/naive-n05-exl3         # logs, Triton / vLLM caches
CUDA_HOME=/usr/local/cuda-13.0
EXTRA_CPATH=                    # only if python3.12-dev is not installed: dir holding Python.h

# --- serving profile --------------------------------------------------------------------------
PORT=8000
HOST=0.0.0.0
SERVED_NAME=naive-n0.5-flash    # model id clients send
REASONING_PARSER=qwen3          # splits <think>...</think> into reasoning_content; empty = off
TOOL_PARSER=naive_n05           # Qwen3-Coder tool parsing + grammar on <tool_call>; empty = off
CHAT_TEMPLATE=$REPO/config/chat_template.jinja   # corrected template (see README); empty = the pack's own
MAX_MODEL_LEN=131072            # 64K prompt + 64K output fits
MAX_NUM_SEQS=1
SPEC_TOKENS=3                   # DSpark draft tokens; 0 disables speculative decoding
GPU_MEM_UTIL=0.80               # lower it if anything else runs on the Sparks (see README)
