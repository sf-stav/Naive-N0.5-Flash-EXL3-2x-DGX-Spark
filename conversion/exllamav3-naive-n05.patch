+from __future__ import annotations
+from typing_extensions import override
+import torch
+from .linear import Linear
+from .quant import LinearFP16
+
+# Split v_proj with v_head_dim < head_dim: the checkpoint stores [num_kv_heads * v_head_dim,
+# hidden] and the attention stack wants [num_kv_heads * head_dim, hidden] with each head's real
+# v_head_dim rows first and zeros after. The generic loader pads the (out, in) matrix by
+# appending rows at the end, which scrambles the head layout (head 0 would absorb head 1's
+# rows); this reader places the rows per head instead. Used by Naive-N0.5-Flash (QK 192 / V
+# 128); MiMo-V2 fuses qkv and pads in its own reader.
+
+
+class NaiveVProj(Linear):
+
+    def __init__(
+        self,
+        config,
+        key: str,
+        in_features: int,
+        out_features: int,
+        num_kv_heads: int,
+        head_dim: int,
+        v_head_dim: int,
+        **kwargs,
+    ):
+        kwargs.setdefault("trim_padded_out", True)
+        super().__init__(config, key, in_features, out_features, **kwargs)
+        self.num_kv_heads = num_kv_heads
+        self.head_dim = head_dim
+        self.v_head_dim = v_head_dim
+        assert out_features == num_kv_heads * head_dim
+        assert 0 < v_head_dim <= head_dim
+
+    @override
+    def load_fp16(self, key: str | list[str]) -> bool:
+
+        if not self.config.stc.has_tensor_group(key, ["weight"]):
+            return False
+
+        w = self.config.stc.get_tensor(
+            key + ".weight", self.device, transpose = False, no_defer = True,
+        )
+        assert w.dim() == 2 and w.shape[0] == self.num_kv_heads * self.v_head_dim, \
+            f"{self.key}: expected [{self.num_kv_heads * self.v_head_dim}, {self.in_features}], got {tuple(w.shape)}"
+        w = w.T.contiguous().float()                       # (in, kv * v_head_dim)
+        in_f = w.shape[0]
+        padded = w.new_zeros((in_f, self.num_kv_heads, self.head_dim))
+        padded[:, :, : self.v_head_dim] = w.view(in_f, self.num_kv_heads, self.v_head_dim)
+        weight = padded.reshape(in_f, self.num_kv_heads * self.head_dim).half().contiguous()
+
+        bias = self.config.stc.get_tensor(
+            key + ".bias", self.device, float2half = True, optional = True, no_defer = True,
+        ) if self.load_bias else None
+        if bias is not None:
+            bias = bias.view(self.num_kv_heads, self.v_head_dim).float()
+            pb = torch.zeros(self.num_kv_heads, self.head_dim, dtype = bias.dtype)
+            pb[:, : self.v_head_dim] = bias
+            bias = pb.reshape(-1).half().contiguous()
+
+        self.inner = LinearFP16(
+            self.in_features,
+            self.out_features,
+            weight,
+            bias,
+            self.full_in_features,
+            self.full_out_features,
+            self.first_in_feature,
+            self.first_out_feature,
+            out_dtype = self.out_dtype,
+            key = self.key,
+        )
+        self.quant_type = "fp16"
+        return True
