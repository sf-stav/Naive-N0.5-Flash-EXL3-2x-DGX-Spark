+from __future__ import annotations
+from typing_extensions import override
+import os
+import torch
+from .module import Module
+from .linear import Linear
+from .layernorm import LayerNorm
+from ..model.config import Config
+
+# Naive-N0.5-Flash DSA indexer (the 9 global layers). Structurally the DeepSeek-V3.2 lightning
+# indexer, but over the plain GQA key stream (not MLA latents): a single 128-dim key head, 16
+# query heads, LayerNorm on the projected keys, partial NEOX RoPE at the query position, and
+# per-token head weights from weights_proj. Keys are stored per token (compress_ratio 1, no
+# block pooling); each query selects the top `token_budget` (2048) visible tokens and the
+# backbone attention runs on that gathered set.
+#
+# Reference: modeling_naive_n05_flash.NaiveN05FlashIndexer.
+#
+# The heavy lifted kernels are the module's existing ones (all shared with the QSA / DSA-on-MLA
+# paths): dsa_indexer_scores for scoring and qsa_sparse_attend_rows for the gathered GQA
+# attention. Planes are maintained in torch here (the compiled QSA plane kernels hardwire
+# RMSNorm + uniform head weights and do not fit this scorer); the per-call cost is a projection
+# plus a norm/rope over the current chunk only, which is cheap next to the expert GEMMs.
+
+# Selection loop tiling: query rows and key positions per score tile (fp32 scores are
+# (b, rows, tile, heads) before the head reduction, so this bounds the workspace)
+_SEL_ROWS = 256
+_SEL_TILE = 4096
+
+
+def _rope_partial(x: torch.Tensor, cos: torch.Tensor, sin: torch.Tensor) -> torch.Tensor:
+    """Partial NEOX / rotate-half rotary over the first cos.shape[-1] dims of x."""
+    r = cos.shape[-1]
+    x_rope, x_pass = x[..., :r], x[..., r:]
+    h = r // 2
+    rot = torch.cat((-x_rope[..., h:], x_rope[..., :h]), dim = -1)
+    return torch.cat((x_rope * cos + rot * sin, x_pass), dim = -1)
+
+
+def _round_fp8(states: torch.Tensor) -> torch.Tensor:
+    """Reference's per-vector fp8_e4m3 rounding (round_indexer_fp8)."""
+    states = states.float()
+    scale = states.abs().amax(dim = -1, keepdim = True).clamp_min(1e-4) / 448.0
+    return (states / scale).clamp(-448, 448).to(torch.float8_e4m3fn).float() * scale
+
+
+class NaiveDSAIndexer(Module):
+
+    bc_graph_ok = False
+    fp8_round = os.environ.get("EXL3_NAIVE_IDX_FP8", "1") != "0"
+
+    def __init__(
+        self,
+        config: Config | None,
+        key: str,
+        hidden_size: int,
+        n_heads: int,
+        head_dim: int,
+        token_budget: int,
+        norm_eps: float,
+        qmap: str | None = None,
+        qbits_key: str = "bits",
+    ):
+        super().__init__(config = config, key = key, qmap = None)
+        self.hidden_size = hidden_size
+        self.n_heads = n_heads
+        self.head_dim = head_dim
+        self.token_budget = int(token_budget)
+        # cr == 1: one pool entry per token
+        self.compress_ratio = 1
+        self.block_topk = self.token_budget
+        # Reference folds H ** -0.5 into the weights; fold it into the score scale instead so
+        # weights_proj stays raw
+        self.scale = float(n_heads) ** -0.5
+        self.norm_eps = norm_eps
+
+        self.wq = Linear(
+            config = config, key = f"{key}.wq",
+            in_features = hidden_size, out_features = n_heads * head_dim,
+            qmap = qmap, out_dtype = torch.half, qbits_key = qbits_key,
+            trim_padded_out = True,
+        )
+        self.wk = Linear(
+            config = config, key = f"{key}.wk",
+            in_features = hidden_size, out_features = head_dim,
+            qmap = qmap, out_dtype = torch.half, qbits_key = qbits_key,
+            trim_padded_out = True,
+        )
+        self.k_norm = LayerNorm(config, f"{key}.k_norm", norm_eps, out_dtype = torch.half)
+        self.weights_proj = Linear(
+            config = config, key = f"{key}.weights_proj",
+            in_features = hidden_size, out_features = n_heads,
+            qmap = qmap, out_dtype = torch.half, qbits_key = qbits_key,
+            trim_padded_out = True,
+        )
+        for m in (self.wq, self.wk, self.k_norm, self.weights_proj):
+            self.register_submodule(m)
+
+        self._nc_w = None
+        self._last_w = None
+
+    _tp_submodules = ("wq", "wk", "k_norm", "weights_proj")
+
+    def storage_size(self):
+        return self.wq.storage_size() + self.wk.storage_size() + self.weights_proj.storage_size()
+
+    @override
+    def optimizer_targets(self):
+        return self.wq.optimizer_targets() + self.wk.optimizer_targets() + \
+            self.weights_proj.optimizer_targets()
+
+    @override
+    def forward(self, x: torch.Tensor, params: dict, out_dtype: torch.dtype | None = None):
+        raise RuntimeError("NaiveDSAIndexer is not a standalone graph module")
+
+    # ------------------------------------------------------------------ helpers
+
+    def _k_pad(self) -> int:
+        return -(-(self.block_topk * self.compress_ratio + self.compress_ratio - 1) // 32) * 32
+
+    def _rope_tables(self, rope, positions: torch.Tensor):
+        """positions: (b, s) int64 -> cos/sin (b, s, rot_width) fp16, rope cache grown as needed"""
+        max_pos = int(positions.max().item()) + 1 if positions.numel() > 0 else 1
+        rope.expand_cache(max_pos)
+        cos = rope.cached_cos.to(positions.device)
+        sin = rope.cached_sin.to(positions.device)
+        return cos[positions].half(), sin[positions].half()
+
+    def _project_q(self, x, rope, positions, params):
+        b, s, _ = x.shape
+        q = self.wq.forward(x.contiguous(), params).view(b, s, self.n_heads, self.head_dim)
+        cos, sin = self._rope_tables(rope, positions)
+        q = _rope_partial(q, cos.unsqueeze(-2), sin.unsqueeze(-2))
+        if self.fp8_round:
+            q = _round_fp8(q)
+        return q
+
+    def _project_k(self, x, rope, positions, params):
+        k = self.wk.forward(x.contiguous(), params)
+        k = self.k_norm.forward(k, params)
+        cos, sin = self._rope_tables(rope, positions)
+        k = _rope_partial(k, cos, sin)
+        if self.fp8_round:
+            k = _round_fp8(k)
+        return k
+
+    def _score_tile(self, q, pk, t0, t1, weights):
+        """Weighted relu indexer scores over key positions [t0, t1): (b, c, t1-t0) fp32"""
+        sc = torch.einsum("bchd,btd->bcth", q.float(), pk[:, t0 : t1].float()).relu()
+        sc = (sc * weights.unsqueeze(-2)).sum(dim = 3) * self.scale
+        return sc
+
+    def _topk_tiled(self, q, pk, weights, qpos, k_pad):
+        """
+        Per-row top-`token_budget` visible tokens.
+        q (b, c, H, dk) fp16 roped; pk (b, T, dk) fp16 roped; weights (b, c, H);
+        qpos (b, c) absolute positions. Returns (b, c, k_pad) int32 sequence positions, -1 pad.
+        Loops the batch and query-row slabs so the fp32 score tile stays
+        (_SEL_ROWS, _SEL_TILE, H): the converter's calibration forwards run hundreds of rows
+        per call.
+        """
+        b, c = q.shape[:2]
+        T = pk.shape[1]
+        budget = self.token_budget
+        out = torch.full((b, c, k_pad), -1, dtype = torch.int32, device = q.device)
+        kk = min(budget, T)
+        if kk <= 0:
+            return out
+        for bi in range(b):
+            for r0 in range(0, c, _SEL_ROWS):
+                r1 = min(r0 + _SEL_ROWS, c)
+                best_v = None
+                best_i = None
+                for t0 in range(0, T, _SEL_TILE):
+                    t1 = min(t0 + _SEL_TILE, T)
+                    sc = self._score_tile(
+                        q[bi : bi + 1, r0 : r1], pk[bi : bi + 1], t0, t1,
+                        weights[bi : bi + 1, r0 : r1],
+                    )
+                    # causal bound: key position <= query position
+                    pos = torch.arange(t0, t1, device = q.device).view(1, 1, -1)
+                    sc = sc.masked_fill(pos > qpos[bi, r0 : r1].view(1, -1, 1), -float("inf"))
+                    kt = min(kk, t1 - t0)
+                    v, i = sc.topk(kt, dim = -1)
+                    i = i + t0
+                    if best_v is None:
+                        best_v, best_i = v, i
+                    else:
+                        best_v = torch.cat([best_v, v], dim = -1)
+                        best_i = torch.cat([best_i, i], dim = -1)
+                        best_v, sel = best_v.topk(kk, dim = -1)
+                        best_i = best_i.gather(-1, sel)
+                ok = best_v > -float("inf")
+                out[bi, r0 : r1, :kk] = \
+                    torch.where(ok, best_i, torch.full_like(best_i, -1)).int().squeeze(0)
+        return out
+
+    # ------------------------------------------------------- non-cached (prefill / calibration)
+
+    def project(self, x: torch.Tensor, rope, params: dict, position: int = 0):
+        """Returns (q (b, s, H, dk) roped, raw_k (b, s, dk) unnormed/unroped)"""
+        b, s, _ = x.shape
+        pos = position + torch.arange(s, device = x.device)
+        pos = pos.unsqueeze(0).expand(b, -1)
+        q = self._project_q(x, rope, pos, params)
+        raw_k = self.wk.forward(x.contiguous(), params)
+        self._nc_w = self.weights_proj.forward(x.contiguous(), params)
+        return q, raw_k
+
+    def pool_keys(self, raw_k: torch.Tensor, rope, params: dict):
+        """key norm + rope (+ fp8 rounding); cr == 1 so this is per token"""
+        b, T, _ = raw_k.shape
+        pos = torch.arange(T, device = raw_k.device).unsqueeze(0).expand(b, -1)
+        k = self.k_norm.forward(raw_k.contiguous(), params)
+        cos, sin = self._rope_tables(rope, pos)
+        k = _rope_partial(k, cos, sin)
+        if self.fp8_round:
+            k = _round_fp8(k)
+        return k
+
+    def select_indices(
+        self,
+        q_idx: torch.Tensor,
+        pooled: torch.Tensor,
+        past_len: int,
+        batch_stride: int,
+    ) -> torch.Tensor:
+        """Per-row top-k over the current chunk keys; flat (b * batch_stride + t) indices"""
+        b, c = q_idx.shape[:2]
+        w = self._nc_w
+        assert w is not None and w.shape[:2] == (b, c), "NaiveDSAIndexer: missing NC weights"
+        qpos = past_len + torch.arange(c, device = q_idx.device).unsqueeze(0).expand(b, -1)
+        # pad pooled to see all keys; positions run 0..T-1
+        k_pad = self._k_pad()
+        idx = self._topk_tiled(q_idx, pooled, w, qpos, k_pad)
+        boffs = (torch.arange(b, device = q_idx.device) * batch_stride).view(b, 1, 1)
+        idx = torch.where(idx >= 0, idx + boffs, idx)
+        return idx.view(b * c, k_pad)
+
+    def sparse_attend_nc(self, attn, q, k, v, q_idx, pooled):
+        from .attention_fn.qsa_triton import qsa_sparse_attend_rows
+        b, s = q.shape[:2]
+        indices = self.select_indices(q_idx, pooled, past_len = 0, batch_stride = s)
+        o = qsa_sparse_attend_rows(
+            q.reshape(b * s, attn.num_q_heads, attn.head_dim).contiguous(),
+            k.reshape(b * s, attn.num_kv_heads, attn.head_dim).contiguous(),
+            v.reshape(b * s, attn.num_kv_heads, attn.head_dim).contiguous(),
+            indices, attn.sm_scale,
+        )
+        return o.view(b, s, attn.num_q_heads, attn.head_dim)
+
+    # ------------------------------------------------------------------ cached path
+
+    def sparse_threshold(self) -> int:
+        # Dense attention is exact while no query can see more tokens than the budget.
+        # EXL3_NAIVE_IDX_THRESHOLD lowers this for conversion only, so calibration rows
+        # (2048 cols) still exercise the indexer and capture its Hessians.
+        return int(os.environ.get("EXL3_NAIVE_IDX_THRESHOLD", self.token_budget))
+
+    def update_planes(
+        self,
+        layer,
+        x: torch.Tensor,
+        rope,
+        block_table: torch.Tensor,
+        cache_seqlens_cpu: torch.Tensor,
+        params: dict,
+    ) -> torch.Tensor:
+        """Maintain the per-token indexer key plane; returns roped indexer queries."""
+        b, s, _ = x.shape
+        dev = x.device
+        pos0 = cache_seqlens_cpu.long().to(dev)
+        pos_ids = pos0.unsqueeze(1) + torch.arange(s, device = dev)
+        q = self._project_q(x, rope, pos_ids, params)
+        k = self._project_k(x, rope, pos_ids, params)
+        self._last_w = self.weights_proj.forward(x.contiguous(), params)
+
+        page_sz = layer.pooled.shape[1]
+        bt = block_table.long()
+        flat = bt.gather(1, pos_ids // page_sz) * page_sz + pos_ids % page_sz
+        layer.pooled.view(-1, self.head_dim)[flat.flatten()] = k.reshape(-1, self.head_dim)
+        return q
+
+    def _gather_paged_keys(self, layer, block_table, total: int):
+        """Gather the pooled plane (per-token keys) for positions 0..total-1: (b, total, dk)"""
+        page_sz = layer.pooled.shape[1]
+        bt = block_table.long()
+        rows = torch.arange(total, device = layer.pooled.device).unsqueeze(0).expand(bt.shape[0], -1)
+        flat = bt.gather(1, rows // page_sz) * page_sz + rows % page_sz
+        return layer.pooled.view(-1, self.head_dim)[flat]  # (b, total, dk)
+
+    def select_indices_paged(
+        self,
+        layer,
+        q_idx: torch.Tensor,
+        block_table: torch.Tensor,
+        cache_seqlens_cpu: torch.Tensor,
+    ) -> torch.Tensor:
+        """Per-row top-k over the cached per-token keys; returns sequence positions, -1 padded"""
+        b, s = q_idx.shape[:2]
+        w = self._last_w
+        assert w is not None and w.shape[:2] == (b, s), "NaiveDSAIndexer: missing cached weights"
+        pos0 = cache_seqlens_cpu.long().to(q_idx.device)
+        total = int(pos0.max().item()) + s
+        pk = self._gather_paged_keys(layer, block_table, total)
+        qpos = pos0.unsqueeze(1) + torch.arange(s, device = q_idx.device)
+        k_pad = self._k_pad()
+        idx = self._topk_tiled(q_idx, pk, w, qpos, k_pad)
+        return idx.view(b * s, k_pad)
+
+    def sparse_attend(
+        self,
+        layer,
+        attn,
+        q: torch.Tensor,
+        q_idx: torch.Tensor,
+        block_table: torch.Tensor,
+        cache_seqlens_cpu: torch.Tensor,
+    ) -> torch.Tensor:
+        from .attention_fn.qsa_triton import qsa_sparse_attend_rows
+        from ..cache.quant import CacheLayer_quant
+        b, s = q.shape[:2]
+        indices = self.select_indices_paged(layer, q_idx, block_table, cache_seqlens_cpu)
+        bt_rows = block_table.int().unsqueeze(1).expand(b, s, -1).reshape(b * s, -1).contiguous()
+        if isinstance(layer, CacheLayer_quant):
+            qk, sk, qv, sv, kb, vb = layer.get_qkv()
+            k_arg, v_arg, qc, page_size = qk, qv, (sk, sv, kb, vb), qk.shape[1]
+        else:
+            k_arg = layer.k.view(-1, attn.num_kv_heads, attn.head_dim)
+            v_arg = layer.v.view(-1, attn.num_kv_heads, attn.head_dim)
+            qc, page_size = None, layer.k.shape[1]
+        o = qsa_sparse_attend_rows(
+            q.reshape(b * s, attn.num_q_heads, attn.head_dim).contiguous(),
+            k_arg, v_arg, indices, attn.sm_scale,
+            block_table = bt_rows, page_size = page_size,
+            qc = qc, n_kv_heads = attn.num_kv_heads,
+        )
+        return o.view(b, s, attn.num_q_heads, attn.head_dim)
